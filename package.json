{
  "name": "hyaw-crm-management",
  "private": true,
  "version": "0.1.0",
  "packageManager": "pnpm@10.17.1",
  "scripts": {
    "dev": "nx run-many -t dev --projects=web,admin,api --parallel=3",
    "dev:web": "nx dev web",
    "dev:admin": "nx dev admin",
    "dev:api": "nx dev api",
    "run-many": "nx run-many",
    "run-many:dev": "nx run-many -t dev --projects=web,admin,api --parallel=3",
    "run-many:build": "nx run-many -t build --all --parallel=3",
    "run-many:typecheck": "nx run-many -t typecheck --all --parallel=3",
    "build": "nx run-many -t build --all --parallel=3",
    "typecheck": "nx run-many -t typecheck --all --parallel=3",
    "db:generate": "prisma generate",
    "db:push": "prisma db push",
    "format": "prettier --write .",
    "db:seed": "tsx prisma/seed.ts",
    "db:setup": "pnpm db:generate && pnpm db:push && pnpm db:seed"
  },
  "dependencies": {
    "@prisma/client": "^6.16.2",
    "@radix-ui/react-dialog": "^1.1.15",
    "@radix-ui/react-label": "^2.1.7",
    "@radix-ui/react-select": "^2.2.6",
    "@radix-ui/react-slot": "^1.2.3",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.5",
    "dotenv": "^17.2.2",
    "express": "^5.1.0",
    "helmet": "^8.1.0",
    "lucide-react": "^0.544.0",
    "next": "^15.5.3",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "tailwind-merge": "^3.3.1",
    "zod": "^4.1.8",
    "bcryptjs": "^3.0.2",
    "jsonwebtoken": "^9.0.2"
  },
  "devDependencies": {
    "@nx/next": "^21.5.2",
    "@nx/node": "^21.5.2",
    "@types/cookie-parser": "^1.4.9",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.3",
    "@types/node": "^24.3.1",
    "@types/react": "^19.1.13",
    "@types/react-dom": "^19.1.9",
    "nx": "^21.5.2",
    "prettier": "^3.6.2",
    "prisma": "^6.16.2",
    "tsx": "^4.20.5",
    "typescript": "^5.9.2",
    "@types/jsonwebtoken": "^9.0.10"
  }
}
