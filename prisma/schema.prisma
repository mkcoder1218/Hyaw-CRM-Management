generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum TenantStatus {
  TRIAL
  ACTIVE
  SUSPENDED
  CANCELLED
}

enum LeadStatus {
  NEW
  CONTACTED
  QUALIFIED
  PROPOSAL
  WON
  LOST
}

enum HrCallOutcome {
  NOT_CALLED
  NO_ANSWER
  HR_INTERESTED
  HR_NOT_NEEDED
  OTHER_NEED_FOUND
  NOT_INTERESTED
}

enum ClientRequestStatus {
  NEW
  REVIEWING
  NEEDS_CLARIFICATION
  APPROVED
  PROPOSAL
  IN_DEVELOPMENT
  DELIVERED
  CLOSED
}

enum ActivityType {
  NOTE
  CALL
  EMAIL
  MEETING
  TASK
  STATUS_CHANGE
}

enum SopRunStatus {
  NOT_STARTED
  IN_PROGRESS
  BLOCKED
  COMPLETED
  CANCELLED
}

model Tenant {
  id           String        @id @default(cuid())
  name         String
  slug         String        @unique
  status       TenantStatus  @default(TRIAL)
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt
  users        TenantUser[]
  roles        Role[]
  leads        Lead[]
  pipelines    Pipeline[]
  sops         Sop[]
  subscription Subscription?
  settings     TenantSetting[]
  auditLogs    AuditLog[]
  companies    Company[]
  contacts     Contact[]
  opportunities Opportunity[]
  crmTasks     CrmTask[]
  leadCampaigns LeadCampaign[]
  discoveredLeads DiscoveredLead[]
  clientRequests ClientRequest[]
}

model User {
  id           String       @id @default(cuid())
  email        String       @unique
  passwordHash String
  firstName    String
  lastName     String
  active       Boolean      @default(true)
  createdAt    DateTime     @default(now())
  tenants      TenantUser[]
  ownedLeads   Lead[]       @relation("LeadOwner")
  activities   Activity[]
  sopRuns      SopRun[]     @relation("SopRunOwner")
  submittedRequests ClientRequest[] @relation("ClientRequestSubmitter")
}

model TenantUser {
  id        String   @id @default(cuid())
  tenantId  String
  userId    String
  roleId    String?
  createdAt DateTime @default(now())
  tenant    Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  role      Role?    @relation(fields: [roleId], references: [id], onDelete: SetNull)

  @@unique([tenantId, userId])
  @@index([tenantId])
}

model Role {
  id          String           @id @default(cuid())
  tenantId    String
  name        String
  description String?
  tenant      Tenant           @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  members     TenantUser[]
  permissions RolePermission[]

  @@unique([tenantId, name])
}

model Permission {
  id          String           @id @default(cuid())
  key         String           @unique
  description String?
  roles       RolePermission[]
}

model RolePermission {
  roleId       String
  permissionId String
  role         Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission   Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@id([roleId, permissionId])
}

model Lead {
  id             String      @id @default(cuid())
  tenantId       String
  ownerId        String?
  firstName      String
  lastName       String
  email          String?
  phone          String?
  company        String?
  title          String?
  source         String?
  status         LeadStatus  @default(NEW)
  score          Int         @default(0)
  estimatedValue Decimal     @default(0) @db.Decimal(14, 2)
  nextFollowUpAt DateTime?
  hrCallOutcome HrCallOutcome @default(NOT_CALLED)
  createdAt      DateTime    @default(now())
  updatedAt      DateTime    @updatedAt
  tenant         Tenant      @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  owner          User?       @relation("LeadOwner", fields: [ownerId], references: [id], onDelete: SetNull)
  activities     Activity[]
  sopRuns        SopRun[]
  clientRequests ClientRequest[]

  @@index([tenantId, status])
  @@index([tenantId, ownerId])
}

model Pipeline {
  id        String          @id @default(cuid())
  tenantId  String
  name      String
  isDefault Boolean         @default(false)
  tenant    Tenant          @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  stages    PipelineStage[]

  @@unique([tenantId, name])
}

model PipelineStage {
  id          String   @id @default(cuid())
  pipelineId  String
  name        String
  position    Int
  probability Int      @default(0)
  pipeline    Pipeline @relation(fields: [pipelineId], references: [id], onDelete: Cascade)

  @@unique([pipelineId, position])
}

model Activity {
  id          String       @id @default(cuid())
  tenantId    String
  leadId      String?
  userId      String
  type        ActivityType
  subject     String
  body        String?
  dueAt       DateTime?
  completedAt DateTime?
  createdAt   DateTime     @default(now())
  lead        Lead?        @relation(fields: [leadId], references: [id], onDelete: Cascade)
  user        User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([tenantId, leadId])
}

model Sop {
  id          String    @id @default(cuid())
  tenantId    String
  name        String
  description String?
  active      Boolean   @default(true)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  tenant      Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  steps       SopStep[]
  runs        SopRun[]

  @@unique([tenantId, name])
  @@index([tenantId, active])
}

model SopStep {
  id            String       @id @default(cuid())
  sopId         String
  name          String
  description   String?
  position      Int
  dueAfterHours Int?
  required      Boolean      @default(true)
  sop           Sop          @relation(fields: [sopId], references: [id], onDelete: Cascade)
  runSteps      SopRunStep[]

  @@unique([sopId, position])
}

model SopRun {
  id          String       @id @default(cuid())
  sopId       String
  leadId      String?
  ownerId     String?
  status      SopRunStatus @default(NOT_STARTED)
  startedAt   DateTime?
  completedAt DateTime?
  createdAt   DateTime     @default(now())
  sop         Sop          @relation(fields: [sopId], references: [id], onDelete: Cascade)
  lead        Lead?        @relation(fields: [leadId], references: [id], onDelete: SetNull)
  owner       User?        @relation("SopRunOwner", fields: [ownerId], references: [id], onDelete: SetNull)
  steps       SopRunStep[]

  @@index([sopId, status])
  @@index([leadId])
}

model SopRunStep {
  id          String       @id @default(cuid())
  runId       String
  stepId      String
  status      SopRunStatus @default(NOT_STARTED)
  dueAt       DateTime?
  completedAt DateTime?
  note        String?
  run         SopRun       @relation(fields: [runId], references: [id], onDelete: Cascade)
  step        SopStep      @relation(fields: [stepId], references: [id], onDelete: Cascade)

  @@unique([runId, stepId])
}

model Subscription {
  id       String   @id @default(cuid())
  tenantId String   @unique
  plan     String
  status   String
  seats    Int      @default(1)
  startsAt DateTime @default(now())
  endsAt   DateTime?
  tenant   Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
}

model TenantSetting {
  id        String   @id @default(cuid())
  tenantId  String
  key       String
  value     String
  updatedAt DateTime @updatedAt
  tenant    Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([tenantId, key])
}

model AuditLog {
  id        String   @id @default(cuid())
  tenantId  String?
  actorId   String
  action    String
  entity    String
  entityId  String?
  metadata  Json?
  createdAt DateTime @default(now())
  tenant    Tenant?  @relation(fields: [tenantId], references: [id], onDelete: SetNull)

  @@index([tenantId, createdAt])
}

model PlatformSetting {
  id        String   @id @default(cuid())
  key       String   @unique
  value     String
  updatedAt DateTime @updatedAt
}


model Company {
  id String @id @default(cuid())
  tenantId String
  name String
  industry String?
  phone String?
  email String?
  website String?
  address String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  @@index([tenantId, name])
}

model Contact {
  id String @id @default(cuid())
  tenantId String
  name String
  email String?
  phone String?
  company String?
  jobTitle String?
  notes String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  @@index([tenantId, name])
}

model Opportunity {
  id String @id @default(cuid())
  tenantId String
  name String
  company String?
  value Decimal @default(0) @db.Decimal(14, 2)
  stage LeadStatus @default(NEW)
  closeDate DateTime?
  notes String?
  ownerId String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  @@index([tenantId, stage])
}

model CrmTask {
  id String @id @default(cuid())
  tenantId String
  title String
  dueDate DateTime?
  priority String @default("MEDIUM")
  assignee String?
  description String?
  completed Boolean @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  @@index([tenantId, completed])
}


enum DiscoveryLeadStatus {
  NEW
  REVIEWED
  QUALIFIED
  EXCLUDED
  CONVERTED
  REJECTED
}

model LeadCampaign {
  id String @id @default(cuid())
  tenantId String
  name String
  product String
  query String
  location String?
  industry String?
  targetNotes String?
  active Boolean @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  leads DiscoveredLead[]
  @@index([tenantId, active])
}

model DiscoveredLead {
  id String @id @default(cuid())
  tenantId String
  campaignId String
  name String
  company String
  website String?
  email String?
  phone String?
  location String?
  industry String?
  sourceUrl String
  sourceName String?
  description String?
  fitScore Int @default(0)
  priority String @default("MEDIUM")
  likelyProblems Json?
  strategy String?
  openingLine String?
  firstCallGoal String?
  objections Json?
  nextAction String?
  qualificationReason String?
  businessType String?
  confidence Int @default(0)
  isCompetitor Boolean @default(false)
  rejectionReason String?
  rawData Json?
  status DiscoveryLeadStatus @default(NEW)
  convertedLeadId String?
  discoveredAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  campaign LeadCampaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  @@unique([tenantId, sourceUrl])
  @@index([tenantId, status, fitScore])
  @@index([campaignId])
}


model ClientRequest {
  id String @id @default(cuid())
  tenantId String
  leadId String
  submittedById String
  problem String
  currentProcess String?
  requestedSolution String?
  message String
  status ClientRequestStatus @default(NEW)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  lead Lead @relation(fields: [leadId], references: [id], onDelete: Cascade)
  submittedBy User @relation("ClientRequestSubmitter", fields: [submittedById], references: [id], onDelete: Restrict)
  @@index([tenantId, status, createdAt])
  @@index([leadId])
}
